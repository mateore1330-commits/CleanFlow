# ignore all files starting with .
.*

# track this file .gitignore (i.e. do NOT ignore it)
!.gitignore
!.github
!.npmrc
.log

# track readme.md in the root (i.e. do NOT ignore it)
!README.md

# ignore OS generated files
ehthumbs.db
Thumbs.db

# ignore Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject

# ignore log files and databases
*.log
*.sql
*.sqlite

# ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ignore node/grunt dependency directories
node_modules/

# Vite build output
dist/*
!public/
!public/*

# dotfiles that must be tracked
!.gitkeep
!.htaccess
!.env.example
.now

# backend stuff
.venv
database.database
database.db
diagram.png
__pycache__/
# migrations/ NO se ignora (DATOS-01): las migraciones son el plano de la
# base de datos y tienen que estar en el repo para que cualquiera pueda
# montarla igual con `pipenv run upgrade`.
