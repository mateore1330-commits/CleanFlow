# Variables de entorno de CleanFlow. Copia este archivo como .env y rellénalo.
# Aquí solo van los NOMBRES y valores de ejemplo: nunca pongas valores reales
# en este archivo, que está en el repo.
#   Front:    import.meta.env.NOMBRE  (solo las que empiezan por VITE_)
#   Servidor: os.getenv("NOMBRE")

# --- Servidor (Flask) ---
# En local, si falta, se usa un SQLite temporal. En producción es obligatoria:
# en Vercel, la conexión agrupada (pooled) de Neon.
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/cleanflow
# Las dos claves son obligatorias: sin ellas, o con menos de 32
# caracteres, el servidor no arranca y dice cuál falta. Una distinta para
# cada una, larga y aleatoria. Para crear una:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# La de Flask (hoy solo la usa /admin, en local):
FLASK_APP_KEY=
FLASK_APP=src/app.py
# 1 = modo local: abre /admin, que deja ver y borrar todas las tablas sin
# contraseña. NUNCA en producción: allí, sin esta variable.
FLASK_DEBUG=1
DEBUG=TRUE
CLOUDINARY_URL=
# La que firma las sesiones. Si se cambia, todos tienen que volver a entrar.
JWT_SECRET_KEY=
GOOGLE_CLIENT_ID=

# --- Front (Vite) ---
VITE_BASENAME=/
# Dónde está la API, solo en local (Vite y Flask van en puertos distintos).
# En Vercel NO se pone: la web llama a /api de su propio dominio.
VITE_BACKEND_URL=http://127.0.0.1:3001
VITE_GOOGLE_CLIENT_ID=
