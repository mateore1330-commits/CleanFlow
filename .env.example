# Variables de entorno de CleanFlow. Copia este archivo como .env y rellénalo.
# Aquí solo van los NOMBRES y valores de ejemplo: nunca pongas valores reales
# en este archivo, que está en el repo.
#   Front:    import.meta.env.NOMBRE  (solo las que empiezan por VITE_)
#   Servidor: os.getenv("NOMBRE")

# --- Servidor (Flask) ---
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/cleanflow
FLASK_APP_KEY=
FLASK_APP=src/app.py
FLASK_DEBUG=1
DEBUG=TRUE
CLOUDINARY_URL=
# Larga y aleatoria: 32 caracteres o más
JWT_SECRET_KEY=
GOOGLE_CLIENT_ID=

# --- Front (Vite) ---
VITE_BASENAME=/
VITE_BACKEND_URL=http://127.0.0.1:3001
VITE_GOOGLE_CLIENT_ID=
